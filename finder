    rTitleBar.BackgroundColor3 = COLORS.TitleBar
    rTitleBar.BorderSizePixel = 0
    rTitleBar.Parent = resultsFrame
    makeCorner(10, rTitleBar)

    local rTitleCover = Instance.new("Frame")
    rTitleCover.BackgroundColor3 = COLORS.TitleBar
    rTitleCover.BorderSizePixel = 0
    rTitleCover.Size = UDim2.new(1, 0, 0, 10)
    rTitleCover.Position = UDim2.new(0, 0, 1, -10)
    rTitleCover.ZIndex = 1
    rTitleCover.Parent = rTitleBar

    local rTitleLabel = Instance.new("TextLabel")
    rTitleLabel.BackgroundTransparency = 1
    rTitleLabel.Size = UDim2.new(1, -40, 1, 0)
    rTitleLabel.Position = UDim2.new(0, 10, 0, 0)
    rTitleLabel.Font = Enum.Font.GothamBold
    rTitleLabel.Text = "Servidores"
    rTitleLabel.TextColor3 = COLORS.ButtonText
    rTitleLabel.TextSize = 14
    rTitleLabel.TextXAlignment = Enum.TextXAlignment.Left
    rTitleLabel.ZIndex = 2
    rTitleLabel.Parent = rTitleBar

    local rCloseButton = Instance.new("TextButton")
    rCloseButton.Size = UDim2.new(0, 22, 0, 22)
    rCloseButton.Position = UDim2.new(1, -28, 0.5, -11)
    rCloseButton.BackgroundColor3 = COLORS.Close
    rCloseButton.Text = "X"
    rCloseButton.Font = Enum.Font.GothamBold
    rCloseButton.TextSize = 13
    rCloseButton.TextColor3 = COLORS.ButtonText
    rCloseButton.ZIndex = 2
    rCloseButton.Parent = rTitleBar
    makeCorner(6, rCloseButton)

    rCloseButton.MouseButton1Click:Connect(closeResultsWindow)

    makeDraggable(resultsFrame, rTitleBar)

    local statusLabel = Instance.new("TextLabel")
    statusLabel.BackgroundTransparency = 1
    statusLabel.Size = UDim2.new(1, -20, 0, 30)
    statusLabel.Position = UDim2.new(0, 10, 0, 40)
    statusLabel.Font = Enum.Font.Gotham
    statusLabel.TextSize = 13
    statusLabel.TextColor3 = COLORS.AccentDark
    statusLabel.Text = "Buscando servidores..."
    statusLabel.Parent = resultsFrame

    local scrollFrame = Instance.new("ScrollingFrame")
    scrollFrame.Size = UDim2.new(1, -16, 1, -50)
    scrollFrame.Position = UDim2.new(0, 8, 0, 40)
    scrollFrame.BackgroundTransparency = 1
    scrollFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
    scrollFrame.ScrollBarThickness = 5
    scrollFrame.ScrollBarImageColor3 = COLORS.Accent
    scrollFrame.Visible = false
    scrollFrame.Parent = resultsFrame

    local listLayout = Instance.new("UIListLayout")
    listLayout.Padding = UDim.new(0, 5)
    listLayout.SortOrder = Enum.SortOrder.LayoutOrder
    listLayout.Parent = scrollFrame

    listLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        scrollFrame.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 10)
    end)

    task.spawn(function()
        local ok, servers = pcall(fetchServers)

        if not ok or not servers or #servers == 0 then
            if resultsFrame then statusLabel.Text = "Nada encontrado. Tentando de novo..." end
            task.wait(1)
            local ok2, servers2 = pcall(fetchServers)
            if ok2 and servers2 and #servers2 > 0 then
                servers = servers2
                ok = true
            end
        end

        if not resultsFrame then return end -- janela foi fechada enquanto buscava

        if ok and servers and #servers > 0 then
            servers = sortServers(servers)
            local top30 = {}
            for i = 1, math.min(30, #servers) do
                top30[i] = servers[i]
            end

            for i, server in ipairs(top30) do
                createServerRow(scrollFrame, server, i)
            end

            statusLabel.Visible = false
            scrollFrame.Visible = true
        else
            statusLabel.Text = "Não foi possível carregar os servidores."
        end
    end)
end

