local function createServerRow(parentScroll, server, index)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -6, 0, 38)
    row.BackgroundColor3 = (index % 2 == 0) and COLORS.RowEven or COLORS.RowOdd
    row.BorderSizePixel = 0
    row.LayoutOrder = index
    row.Parent = parentScroll
    makeCorner(6, row)

    local info = Instance.new("TextLabel")
    info.BackgroundTransparency = 1
    info.Size = UDim2.new(1, -80, 1, 0)
    info.Position = UDim2.new(0, 8, 0, 0)
    info.Font = Enum.Font.Gotham
    info.TextSize = 12
    info.TextColor3 = COLORS.Text
    info.TextXAlignment = Enum.TextXAlignment.Left
    info.Text = string.format("#%d   %d/%d   %dms", index, server.playing, server.maxPlayers, server.ping)
    info.Parent = row

    local joinButton = Instance.new("TextButton")
    joinButton.Size = UDim2.new(0, 64, 0, 26)
    joinButton.Position = UDim2.new(1, -70, 0.5, -13)
    joinButton.BackgroundColor3 = COLORS.Accent
    joinButton.Text = "Entrar"
    joinButton.Font = Enum.Font.GothamBold
    joinButton.TextSize = 12
    joinButton.TextColor3 = COLORS.ButtonText
    joinButton.Parent = row
    makeCorner(6, joinButton)

    joinButton.MouseButton1Click:Connect(function()
        joinButton.Text = "..."
        joinButton.Active = false
        local ok, err = pcall(function()
            TeleportService:TeleportToPlaceInstance(placeId, server.id, player)
        end)
        if not ok then
            joinButton.Text = "Erro"
            warn("Falha ao entrar no servidor:", err)
            task.wait(1.5)
            joinButton.Text = "Entrar"
            joinButton.Active = true
        end
    end)
end

