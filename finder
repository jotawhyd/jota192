-- ======================= LÓGICA DE SERVIDORES =======================

local function safeHttpGet(url, attempts)
    attempts = attempts or 3
    for i = 1, attempts do
        local ok, result = pcall(function()
            return game:HttpGet(url)
        end)
        if ok and result then
            return true, result
        end
        task.wait(0.5)
    end
    return false, nil
end

local function fetchServers()
    local allServers = {}
    local cursor = ""
    local pagesToFetch = 6
    local baseUrl = "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100&cursor=%s"

    for page = 1, pagesToFetch do
        local url = baseUrl:format(placeId, HttpService:UrlEncode(cursor))
        local ok, body = safeHttpGet(url, 3)
        if not ok then break end

        local decodeOk, decoded = pcall(function()
            return HttpService:JSONDecode(body)
        end)
        if not decodeOk or not decoded or not decoded.data then break end

        for _, server in ipairs(decoded.data) do
            if server.id ~= currentJobId and server.playing and server.maxPlayers then
                table.insert(allServers, {
                    id = server.id,
                    playing = server.playing,
                    maxPlayers = server.maxPlayers,
                    ping = server.ping or 999,
                })
            end
        end

        if decoded.nextPageCursor and decoded.nextPageCursor ~= "" then
            cursor = decoded.nextPageCursor
        else
            break
        end
    end

    return allServers
end

local function sortServers(servers)
    table.sort(servers, function(a, b)
        if a.playing ~= b.playing then
            return a.playing < b.playing
        end
        return a.ping < b.ping
    end)
    return servers
end

